    "@types/multer": "^1.4.11",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.8",
    "@types/compression": "^1.7.5",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "typescript": "^5.5.3",
    "tsx": "^4.19.0",
    "vitest": "^1.6.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2"
  }
