# UCC Chatbot Assistant Environment Configuration
# Copy this file to .env and update values before deployment.
# NEVER commit the real .env file (it's in .gitignore).

# Server
PORT=8081

# Database - PostgreSQL (Netlify DB) or MySQL
# === Option A (VERIFIED LIVE): Netlify PostgreSQL ===
# Connection is used and verified: 2026-09-02
# Host: ep-lucky-mouse-a5nt5hhl.us-east-2.db.netlify.com
# Database: netlifydb
# Username: netlifydb_owner
DB_TYPE=postgres
DB_URL=jdbc:postgresql://ep-lucky-mouse-a5nt5hhl.us-east-2.db.netlify.com:5432/netlifydb?sslmode=require
DB_USERNAME=netlifydb_owner
DB_PASSWORD=npg_FyursVz6IBg8
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# === Option B: Local MySQL (uncomment to use) ===
# DB_TYPE=mysql
# DB_URL=jdbc:mysql://localhost:3306/ucc_chatbot_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
# DB_USERNAME=root
# DB_PASSWORD=your-mysql-password
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# === Option C: H2 in-memory (for quick local dev) ===
# DB_TYPE=h2
# DB_URL=jdbc:h2:mem:uccchatbot;DB_CLOSE_DELAY=-1
# DB_USERNAME=sa
# DB_PASSWORD=
# DB_DRIVER=org.h2.Driver
# DB_DIALECT=org.hibernate.dialect.H2Dialect

# Optional: wipe and recreate schema on next boot (DANGEROUS - drops ALL tables)
# DB_RESET_ON_BOOT=true

# AI Configuration (OpenAI-compatible)
AI_API_KEY=your-openai-api-key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# JWT - MUST set a strong random secret in production
# Generate with: openssl rand -base64 48
JWT_SECRET=icmjsOTTJ4c70d2RxxavpWG1ajTMADdI0uCflQ/559gH6mRcYpZ8vPNsg8fGp4dn
JWT_EXPIRATION_MS=604800000

# Admin User - DataLoader seeds this user on first run
ADMIN_EMAIL=admin@ucc.co.tz
ADMIN_PASSWORD=ChangeMeOnFirstLogin!
ADMIN_NAME=UCC Administrator

# CORS (add your frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:8081,https://uccchatbot.netlify.app

# Frontend URL
FRONTEND_URL=https://uccchatbot.netlify.app
